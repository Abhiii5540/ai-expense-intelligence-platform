# Port exposed by the Spring Boot AI service.
PORT=8000

# Gemini API credential. Keep real keys only in an ignored .env file or deployment secret store.
GEMINI_API_KEY=your_gemini_api_key

# Stable Gemini model used for structured expense insights.
GEMINI_MODEL=gemini-2.5-flash

# Provider endpoint and HTTP timeouts.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_CONNECT_TIMEOUT=5s
GEMINI_READ_TIMEOUT=30s
