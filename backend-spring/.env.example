# Port exposed by the Spring Boot expense API.
PORT=4000

# JDBC connection details for PostgreSQL.
DATABASE_URL=jdbc:postgresql://localhost:5433/ai_expense_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace_with_your_database_password

# Use a random value of at least 32 characters in production.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Base URL of the Spring Boot AI insights service.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=30s

# Keep enabled for normal application startup.
FLYWAY_ENABLED=true
