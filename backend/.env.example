# Runtime environment for the Express API.
# Use "development" locally and "production" in deployed environments.
NODE_ENV=development

# Port used by the backend API server.
PORT=4000

# PostgreSQL connection string used by Prisma.
# Local example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_expense_db?schema=public"
# Production example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Secret key used to sign and verify JWT access tokens.
# Replace this with a long, random value in every real environment.
JWT_SECRET="replace_with_a_long_secure_secret"

# Token lifetime for authenticated user sessions.
# Examples: "1d", "7d", "30d"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins for CORS.
# Local Vite example: "http://127.0.0.1:5173"
# Production example: "https://your-frontend.vercel.app"
CORS_ORIGIN="http://127.0.0.1:5173"

# Base URL for the FastAPI AI service used to generate Gemini insights.
# Local example: "http://127.0.0.1:8000"
# Production example: "https://your-ai-service.onrender.com"
AI_SERVICE_URL="http://127.0.0.1:8000"
